# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Better Auth / NextAuth-style secret)
AUTH_SECRET=replace-with-random-32-plus-char-secret
AUTH_TRUST_HOST=true

# Database (MongoDB local)
MONGODB_URI=mongodb://127.0.0.1:27017/testy
DATABASE_NAME=testy

# Jira integration
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=qa-bot@company.com
JIRA_API_TOKEN=replace-with-jira-api-token
JIRA_PROJECT_KEY=TEST

# GitHub integration
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo-name
GITHUB_DEFAULT_BRANCH=main

# Optional storage for bug screenshot evidence
UPLOAD_PROVIDER=local
UPLOAD_BASE_URL=http://localhost:3000/uploads
